# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@db:5432/support_tickets

# ── Flomni ────────────────────────────────────────────────────────────────────
FLOMNI_API_KEY=your_flomni_api_key_here
FLOMNI_API_BASE_URL=https://api.flomni.com
# Leave empty to skip webhook signature verification
FLOMNI_WEBHOOK_SECRET=

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-nano

# ── App ───────────────────────────────────────────────────────────────────────
WEBHOOK_PORT=8000
LOG_LEVEL=INFO

