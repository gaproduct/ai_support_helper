# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@db:5432/support_tickets

# ── Flomni ────────────────────────────────────────────────────────────────────
FLOMNI_API_KEY=your_flomni_api_key_here
FLOMNI_API_BASE_URL=https://api.flomni.com
# Leave empty to skip webhook signature verification
FLOMNI_WEBHOOK_SECRET=

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-nano

# ── Supabase (KB vector store) ────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C0000000000
SLACK_DRAFTS_CHANNEL_ID=C0000000000
SLACK_SIGNING_SECRET=your_slack_signing_secret

# ── ChatApp ───────────────────────────────────────────────────────────────────
CHATAPP_BASE_URL=https://api.chatapp.online
CHATAPP_EMAIL=your_chatapp_email
CHATAPP_PASSWORD=your_chatapp_password
CHATAPP_APP_ID=your_chatapp_app_id
CHATAPP_LICENSE_ID=your_chatapp_license_id
# Comma-separated, e.g. "WhatsApp,Telegram,grWhatsApp"
CHATAPP_MESSENGER_TYPES=
# ISO-8601 — from which moment to backfill history
CHATAPP_HISTORY_FROM=2026-05-01T00:00:00Z

# ── App ───────────────────────────────────────────────────────────────────────
WEBHOOK_PORT=8000
LOG_LEVEL=INFO
